# SQLite database location (relative to minott-web/)
DATABASE_URL="file:./prisma/app.db"

# BetterAuth — the single Accounts Portal login (admin/customer/rep roles).
# Required: without these, nobody (including admins) can sign in.
# Secret signs portal session tokens. Generate with: openssl rand -hex 32
#
# The seed creates one admin account to bootstrap access:
#   admin@example.com / test123
# Sign in at /portal/sign-in, then in production invite a real admin
# (/portal/admins) and deactivate the seeded one.
# Optional overrides for the seeded admin's email/password (recommended for
# production deploys, in place of rotating after the fact):
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="test123"
BETTER_AUTH_SECRET="set-a-32+-char-random-string"
# Base URL BetterAuth runs on (server). In prod set to your public origin.
BETTER_AUTH_URL="http://localhost:3000"
# Same origin, exposed to the browser for the portal auth client.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Resend — transactional email (inquiry notifications + confirmations).
# Sending is skipped with a console warning when unset.
RESEND_API_KEY=""

# Optional site-wide preview password. When set, every public page requires
# this password once per browser session (visitors unlock at /preview).
# /portal and /set-password keep their own auth and are NOT behind this gate.
# Unset (or leave empty) to make the site public — no code change needed.
SITE_PASSWORD=""

# HMAC key used to sign the preview session cookie above. Only needed when
# SITE_PASSWORD is set — otherwise it signs nothing and can stay unset.
SESSION_SECRET="set-a-long-random-string"

# Integration API key for the authenticated endpoints under /api/customers/*
# and /api/quotes (used by the OneChat WhatsApp/voice agents). When unset, those
# endpoints return 503 and nothing else changes. Generate with: openssl rand -hex 32
INTEGRATION_API_KEY=""
