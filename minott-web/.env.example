# SQLite database location (relative to minott-web/)
DATABASE_URL="file:./prisma/app.db"

# Admin login (single shared password)
ADMIN_PASSWORD="set-a-strong-password"

# HMAC key used to sign the admin session cookie
SESSION_SECRET="set-a-long-random-string"

# BetterAuth — customer/B2B portal (separate from the shared-password admin gate)
# Secret signs portal session tokens. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="set-a-32+-char-random-string"
# Base URL BetterAuth runs on (server). In prod set to your public origin.
BETTER_AUTH_URL="http://localhost:3000"
# Same origin, exposed to the browser for the portal auth client.
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Resend — transactional email (inquiry notifications + confirmations).
# Sending is skipped with a console warning when unset.
RESEND_API_KEY=""
